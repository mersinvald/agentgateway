---
source: crates/llm/src/golden_tests.rs
description: src/tests/requests/completions/codex/full.json
info:
  model: gpt-5.6-luna
  messages:
    - role: system
      content: Be helpful.
    - role: developer
      content:
        - type: text
          text: Use tools when needed.
    - role: user
      content:
        - type: text
          text: Describe this.
        - type: image_url
          image_url:
            url: "https://example.com/image.png"
            detail: high
    - role: assistant
      content: Checking.
      tool_calls:
        - id: call_1
          type: function
          function:
            name: lookup
            arguments: "{\"query\":\"image\"}"
    - role: tool
      tool_call_id: call_1
      content: Found a cat.
    - role: assistant
      content: ~
      tool_calls:
        - id: call_2
          type: function
          function:
            name: lookup
            arguments: "{}"
    - role: tool
      tool_call_id: call_2
      content:
        - type: text
          text: Confirmed.
    - role: assistant
      content: ~
      refusal: Cannot help with that request.
    - role: assistant
      content:
        - type: text
          text: "For that alternative: "
        - type: refusal
          refusal: I cannot provide those details.
    - role: user
      content: Hello
  temperature: 0.7
  max_tokens: 256
  max_completion_tokens: 512
  n: 1
  logprobs: false
  top_logprobs: ~
  logit_bias: {}
  frequency_penalty: 0
  presence_penalty: 0
  top_p: 1
  stop: ~
  seed: ~
  store: false
  stream: true
  stream_options:
    include_usage: true
  tools:
    - type: function
      function:
        name: lookup
        description: Look up information
        parameters:
          type: object
          properties:
            query:
              type: string
        strict: false
  tool_choice:
    type: function
    function:
      name: lookup
  parallel_tool_calls: true
  reasoning_effort: high
  response_format:
    type: json_schema
    json_schema:
      name: answer
      description: An answer
      schema:
        type: object
        properties:
          answer:
            type: string
        required:
          - answer
        additionalProperties: false
      strict: true
  metadata:
    session: test
  prompt_cache_key: test-session
  service_tier: auto
