---
source: crates/llm/src/golden_tests.rs
description: src/tests/requests/responses/codex-tools.json
info:
  model: moonshotai/Kimi-K3
  instructions: Complete the task using the supplied tools.
  stream: true
  tools:
    - type: function
      name: agw_tool_1
      parameters:
        type: object
        properties: {}
    - type: namespace
      name: functions
      tools:
        - type: custom
          name: apply_patch
          description: Apply a patch.
          format:
            type: grammar
            syntax: lark
            definition: "start: /.+/"
        - type: function
          name: exec_command
          parameters:
            type: object
            properties:
              cmd:
                type: string
            required:
              - cmd
    - type: custom
      name: apply_patch
      format:
        type: text
  tool_choice:
    type: custom
    namespace: functions
    name: apply_patch
  input:
    - role: user
      content: Update hello.txt
    - type: custom_tool_call
      id: ctc_history
      call_id: call_patch
      namespace: functions
      name: apply_patch
      input: "*** Begin Patch\n*** Add File: hello.txt\n+привет\n*** End Patch"
    - type: function_call
      id: fc_history
      call_id: call_exec
      namespace: functions
      name: exec_command
      arguments: "{\"cmd\":\"pwd\"}"
    - type: custom_tool_call_output
      id: ctco_history
      call_id: call_patch
      output: Success
    - type: function_call_output
      call_id: call_exec
      output: /workspace
    - role: user
      content: Continue
---
{
  "request": {
    "messages": [
      {
        "role": "developer",
        "content": "Complete the task using the supplied tools."
      },
      {
        "role": "user",
        "content": "Update hello.txt"
      },
      {
        "role": "assistant",
        "tool_calls": [
          {
            "type": "function",
            "id": "call_patch",
            "function": {
              "name": "agw_tool_2",
              "arguments": "{\"input\":\"*** Begin Patch\\n*** Add File: hello.txt\\n+привет\\n*** End Patch\"}"
            }
          },
          {
            "type": "function",
            "id": "call_exec",
            "function": {
              "name": "agw_tool_3",
              "arguments": "{\"cmd\":\"pwd\"}"
            }
          }
        ]
      },
      {
        "role": "tool",
        "content": "Success",
        "tool_call_id": "call_patch"
      },
      {
        "role": "tool",
        "content": "/workspace",
        "tool_call_id": "call_exec"
      },
      {
        "role": "user",
        "content": "Continue"
      }
    ],
    "model": "moonshotai/Kimi-K3",
    "stream": true,
    "stream_options": {
      "include_usage": true
    },
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "agw_tool_1",
          "parameters": {
            "type": "object",
            "properties": {}
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "agw_tool_2",
          "description": "Tool: functions.apply_patch\nApply a patch.\nPass the complete raw tool input in the input string, without Markdown fences.\nThe input must follow this grammar: {\"type\":\"grammar\",\"syntax\":\"lark\",\"definition\":\"start: /.+/\"}",
          "parameters": {
            "type": "object",
            "properties": {
              "input": {
                "type": "string"
              }
            },
            "required": [
              "input"
            ],
            "additionalProperties": false
          },
          "strict": true
        }
      },
      {
        "type": "function",
        "function": {
          "name": "agw_tool_3",
          "description": "Tool: functions.exec_command\n",
          "parameters": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string"
              }
            },
            "required": [
              "cmd"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "apply_patch",
          "description": "\nPass the complete raw tool input in the input string, without Markdown fences.",
          "parameters": {
            "type": "object",
            "properties": {
              "input": {
                "type": "string"
              }
            },
            "required": [
              "input"
            ],
            "additionalProperties": false
          },
          "strict": true
        }
      }
    ],
    "tool_choice": {
      "type": "function",
      "function": {
        "name": "agw_tool_2"
      }
    }
  },
  "parsed": {
    "input_format": "Responses",
    "cache_convention": "InputIncludesCache",
    "request_model": "moonshotai/Kimi-K3",
    "provider": "gemini",
    "streaming": true,
    "params": {},
    "prompt": [
      {
        "role": "system",
        "content": "Complete the task using the supplied tools."
      },
      {
        "role": "user",
        "content": "Update hello.txt"
      },
      {
        "role": "user",
        "content": "Continue"
      }
    ]
  }
}
